{
  "name": "dsh-plugin-tlnotify",
  "version": "0.1.2",
  "license": "MIT",
  "description": "One IM channel for every DSH session: aggregate 中断/结束/报错/等待操作 into QQ / Feishu notifications with actionable buttons and targeted reply-back routing",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": "./web/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web/client.js",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "smoke:client": "node scripts/smoke-client.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "notification",
    "notify",
    "im",
    "qq",
    "qqbot",
    "feishu",
    "lark",
    "webhook",
    "agent",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltl0312/my-dsh-plugins.git",
    "directory": "packages/tlnotify"
  },
  "bugs": {
    "url": "https://github.com/ltl0312/my-dsh-plugins/issues"
  },
  "homepage": "https://github.com/ltl0312/my-dsh-plugins/tree/main/packages/tlnotify#readme",
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.4"
  },
  "peerDependencies": {
    "cordis": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cordis": "^3.0.0",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
