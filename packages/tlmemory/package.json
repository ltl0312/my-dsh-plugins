{
  "name": "dsh-plugin-tlmemory",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Cross-session and cross-project memory manager for dsh (silent turn-end sedimentation + native web client embedding)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": "./web/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "dist",
    "web/dist",
    "web/client.js"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "smoke:client": "node scripts/smoke-client.mjs"
  },
  "peerDependencies": {
    "cordis": "^3.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.14",
    "cordis": "^3.0.0",
    "esbuild": "^0.27.7",
    "jsdom": "^30.0.1",
    "schemastery": "^3.18.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
