{
  "name": "my-dsh-plugins",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm -r --filter \"./packages/**\" run dev",
    "test": "pnpm -r run test",
    "test:cli": "node --test \"tools/dsh-plugin-cmd/**/*.test.mjs\"",
    "install:cli": "node tools/dsh-plugin-cmd/install.mjs",
    "smoke:client": "pnpm -r --filter \"./packages/**\" run smoke:client"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0"
  }
}
